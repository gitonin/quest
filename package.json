{
  "name": "quest",
  "version": "0.1.0",
  "private": true,
  "description": "Quest of the Three Stars - 16-bit action RPG for mobile",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/smoke.mjs && node scripts/playthrough.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:play": "node scripts/playthrough.mjs"
  },
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
